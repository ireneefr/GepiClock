data_metmap <- read.csv("~/Desktop/MetMap/data/MetMap500.csv")
data_dep <- read.csv("~/Desktop/MetMap/data/CRISPRGeneEffect.csv", row.names = 1)
data_model <- read.csv("~/Desktop/MetMap/data/Model.csv")
# Filter CoRe genes
data_path <- "/Volumes/iorio/Alessandro.D/legacy/EpiClock/data/"
gene_effect <- load_and_filter_genedep_pancancer(
depmap_file = paste0(data_path, "depmap/CRISPRGeneEffect.csv"), # Gene effect matrix from DepMap Public 24Q2 Files
