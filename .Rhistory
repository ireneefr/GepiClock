library(tidyr)
# Calculate statistics for both datasets
gene_group_horvath <- get_gene_group_stats(ann_horvath, "HorvathS2013")
gene_group_hannum <- get_gene_group_stats(ann_hannum, "HannumG2013")
gene_group_horvath2 <- get_gene_group_stats(ann_horvath2, "HorvathS2018")
gene_group_levine <- get_gene_group_stats(ann_levine, "LevineM2018")
gene_group <- get_gene_group_stats(ann_model_cpgs, "RebolloI2025")
gene_group_shared <- get_gene_group_stats(ann_cpgs_shared, "Illumina450k")
# Combine with Illumina array
combined_data <- bind_rows(gene_group,
gene_group_shared)
gene_group_horvath
# Get common genes
gene_horvath <- unique(unlist(strsplit(ann_horvath[ann_horvath$UCSC_RefGene_Name != "", "UCSC_RefGene_Name"], ";")))
gene_horvath
gene_hannum <- unique(unlist(strsplit(ann_hannum[ann_hannum$UCSC_RefGene_Name != "", "UCSC_RefGene_Name"], ";")))
gene_horvath2 <- unique(unlist(strsplit(ann_horvath2[ann_horvath2$UCSC_RefGene_Name != "", "UCSC_RefGene_Name"], ";")))
gene_levine <- unique(unlist(strsplit(ann_levine[ann_levine$UCSC_RefGene_Name != "", "UCSC_RefGene_Name"], ";")))
gene_model_cpgs <- unique(unlist(strsplit(ann_model_cpgs[ann_model_cpgs$UCSC_RefGene_Name != "", "UCSC_RefGene_Name"], ";")))
common_genes <- Reduce(intersect, list(gene_horvath, gene_hannum, gene_horvath2, gene_levine, gene_model_cpgs))
common_genes
