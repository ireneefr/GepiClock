source("~/Desktop/MetMap/load_and_filter_genedep_pancancer.R")
# Load data (MetMap500 & gene dependencies)
data_metmap <- read.csv("~/Desktop/MetMap/data/MetMap500.csv")
data_dep <- read.csv("~/Desktop/MetMap/data/CRISPRGeneEffect.csv", row.names = 1)
data_model <- read.csv("~/Desktop/MetMap/data/Model.csv")
# Filter CoRe genes
data_path <- "/Volumes/iorio/Alessandro.D/legacy/EpiClock/data/"
gene_effect <- load_and_filter_genedep_pancancer(
depmap_file = paste0(data_path, "depmap/CRISPRGeneEffect.csv"), # Gene effect matrix from DepMap Public 24Q2 Files
essential_genes_file = paste0(data_path, "depmap/AchillesCommonEssentialControls.csv"), # Achilles Common Essential genes
nonessential_genes_file = paste0(data_path, "depmap/AchillesNonessentialControls.csv"), # Achilles Never Essential genes
bagel_data_path = paste0(data_path, "BAGEL/")#, # additional essential & non-essential gene sets (BAGEL dataset)
#min_cell_lines = 10 # retain genes depleted (-0.5) in at least 2 cell lines
)
# Filter CoRe genes
data_path <- "/Volumes/iorio/Alessandro.D/legacy/EpiClock/data/"
gene_effect <- load_and_filter_genedep_pancancer(
depmap_file = paste0(data_path, "depmap/CRISPRGeneEffect.csv"), # Gene effect matrix from DepMap Public 24Q2 Files
essential_genes_file = paste0(data_path, "depmap/AchillesCommonEssentialControls.csv"), # Achilles Common Essential genes
nonessential_genes_file = paste0(data_path, "depmap/AchillesNonessentialControls.csv"), # Achilles Never Essential genes
bagel_data_path = paste0(data_path, "BAGEL/")#, # additional essential & non-essential gene sets (BAGEL dataset)
#min_cell_lines = 10 # retain genes depleted (-0.5) in at least 2 cell lines
)
# Transform dependency data (-0.5)
data_dep_binary <- as.data.frame(t(ifelse(gene_effect <= -0.5, "dep", "non-dep")))
data_dep_binary[] <- lapply(data_dep_binary, factor)
# Merge data
data <- merge(merge(data_metmap, data_model, by.x = "CCLE_name", by.y = "CCLEName"),
data_dep_binary, by.x = "ModelID", by.y = "row.names") #407 samples
# Metastatic potential distribution
plot_list <- list()
for(i in grep("^mean", colnames(data_metmap), value = TRUE)) {
# Shapiro-Wilk test
shapiro_p <- shapiro.test(data_metmap[,i])$p.value
pval_text <- paste0("Shapiro-Wilk\np = ", signif(shapiro_p, 3))
# Create plot
p <- ggplot(data_metmap, aes_string(x = i)) +
geom_histogram(bins = 30, fill = "steelblue", color = "black") +
ylab("Frequency") +
annotate("text", x = Inf, y = Inf, label = pval_text, hjust = 1.1, vjust = 1.5, size = 4) +
theme_minimal()
plot_list[[i]] <- p
}
hist_plot <- wrap_plots(plot_list, ncol = 3)
# Compute Wilcoxon test
genes <- colnames(data_dep_binary)
genes
metp500 <- grep("mean", colnames(data_metmap), value = TRUE)
min_cell_lines <- 10
# identify genes with depletion effect <= -0.5 in at least 'min_cell_lines' cell lines
gene_counts <- apply(gene_effect, 1, function(x) sum(x <= -0.5, na.rm = TRUE))
essential_genes <- names(gene_counts[gene_counts >= min_cell_lines])
# keep only significant genes
gene_effect <- gene_effect[rownames(gene_effect) %in% essential_genes, ]
results_list <- list()
for(x in essential_genes[essential_genes %in% colnames(data)]){
row <- list(Gene = x)
for(y in metp500){
# Get non-NA indices
idx <- which(!is.na(data[,x]) & !is.na(data[,y]))
# Check if there are two groups
if (length(unique(data[,x][idx])) < 2) {
pval <- NA
direction <- as.character(unique(data[,x][idx]))  # store the only group
} else {
test <- anova(lm(data[,y][idx] ~ data[,x][idx] + data[,"cancer_type"][idx]))
pval <- signif(test["data[, x][idx]", "Pr(>F)"], 3)
# Get group medians to determine direction
medians <- tapply(data[,y], data[,x], median)
direction <- names(which.max(medians))  # returns "dep" or "non-dep"
diff <- medians["non-dep"] - medians["dep"]
}
tissue <- gsub(".*(brain|lung|liver|bone|kidney|all5).*", "\\1", y)
row[[paste0("P_", tissue)]] <- pval
row[[paste0("Dir_", tissue)]] <- direction
row[[paste0("Diff_", tissue)]] <- diff
}
results_list[[x]] <- row
}
results_list
res_wilcoxon <- do.call(rbind, lapply(results_list, as.data.frame))
# Add adjusted p-values
for(i in grep("^P_", colnames(res_wilcoxon), value = TRUE)) {
res_wilcoxon[[gsub("^P_", "Padj_", i)]] <- p.adjust(as.numeric(res_wilcoxon[[i]]), method = "fdr")
}
# Get significant results
sig_genes <- rownames(res_wilcoxon[rowSums(res_wilcoxon[, grep("^Padj", colnames(res_wilcoxon))] <= 0.05, na.rm = TRUE) > 0, ])
sig_genes
sig_genes <- rownames(res_wilcoxon[
apply(res_wilcoxon, 1, function(row) {
padj_cols <- grep("^Padj_", names(row), value = TRUE)
for (padj_col in padj_cols) {
tissue <- sub("^Padj_", "", padj_col)
diff_col <- paste0("Diff_", tissue)
if (!is.na(row[padj_col]) && as.numeric(row[padj_col]) <= 0.05 &&
!is.na(row[diff_col]) && abs(as.numeric(row[diff_col])) > 1) {
return(TRUE)
}
}
return(FALSE)
}),
])
sig_genes
View(res_wilcoxon[sig_genes,])
# Plot
for(x in sig_genes){
boxplot_list <- list()
for(y in grep("^mean", colnames(data_metmap), value = TRUE)) {
p <- ggplot(data, aes(x = .data[[x]], y = .data[[y]])) +
geom_boxplot() +
geom_jitter(alpha = 0.1) +
ylab(y) +
annotate("text", x = 2, y = Inf, hjust = 1.1, vjust = 1.5, size = 4,
label = paste0("p = ", signif(res_wilcoxon[x, paste0("Padj_", gsub(".*\\.", "", y))], 3))) +
theme_minimal()
boxplot_list[[y]] <- p
}
boxplot <- wrap_plots(boxplot_list, ncol = 3)
ggsave(paste0("~/Desktop/MetMap/plots/metp500_dep_anova_pancancer_", x, ".png"),
boxplot, width = 10, height = 6, dpi = 300)
}
boxplot
View(sig_genes,)
View(sig_genes)
View(res_wilcoxon[sig_genes,])
data
View(data)
metp500
# Plot
for(x in sig_genes){
boxplot_list <- list()
print(x)
for(y in grep("^mean", colnames(data_metmap), value = TRUE)) {
print(y)
print(paste0("Padj_", gsub(".*\\.", "", y)))
print(res_wilcoxon[x, paste0("Padj_", gsub(".*\\.", "", y))])
p <- ggplot(data, aes(x = .data[[x]], y = .data[[y]])) +
geom_boxplot() +
geom_jitter(alpha = 0.1) +
ylab(y) +
annotate("text", x = 2, y = Inf, hjust = 1.1, vjust = 1.5, size = 4,
label = paste0("p = ", signif(res_wilcoxon[x, paste0("Padj_", gsub(".*\\.", "", y))], 3))) +
theme_minimal()
boxplot_list[[y]] <- p
}
boxplot <- wrap_plots(boxplot_list, ncol = 3)
ggsave(paste0("~/Desktop/MetMap/plots/metp500_dep_anova_pancancer_", x, ".png"),
boxplot, width = 10, height = 6, dpi = 300)
}
