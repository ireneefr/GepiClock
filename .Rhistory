correlation_results_ANOVA_gene_pan <- read.csv("correlation_results_ANOVA_gene_pan.csv")
setwd("/Volumes/iorio/Alessandro.D/EpiClock")
correlation_results_ANOVA_gene_pan <- read.csv("correlation_results_ANOVA_gene_pan.csv")
correlation_results_ANOVA_gene_pan <- read.csv("correlation_results_ANOVA_gene_pan.csv")
# perform GSEA
set.seed(123)
# vector of ranked genes
ranked_genes <- correlation_results_ANOVA_gene_pan %>%
arrange(desc(correlation))  # descendent correlatoion (6052 genes)
rankings <- setNames(ranked_genes$correlation, ranked_genes$Gene)  # vector
# convert the format
entrez_ids <- bitr(names(rankings), fromType = "SYMBOL", toType = "ENTREZID", OrgDb = org.Hs.eg.db)
names(rankings) <- entrez_ids$ENTREZID
# ENRICHMENT ANALYSIS
# GO Biological Process (BP)
gseabp <- gseGO(geneList = rankings,
OrgDb = org.Hs.eg.db,
keyType = "ENTREZID",
ont = "BP",
minGSSize = 5,
maxGSSize = 2000,
pvalueCutoff = 0.05)
# GO Molecular Function (MF)
gseamf <- gseGO(geneList = rankings,
OrgDb = org.Hs.eg.db,
keyType = "ENTREZID",
ont = "MF",
minGSSize = 5,
maxGSSize = 2000,
pvalueCutoff = 0.05)
# GO Cellular Component (CC)
gseacc <- gseGO(geneList = rankings,
OrgDb = org.Hs.eg.db,
keyType = "ENTREZID",
ont = "CC",
minGSSize = 5,
maxGSSize = 2000,
pvalueCutoff = 0.05)
# GSEA for KEGG pathways
gseakegg <- gseKEGG(geneList = rankings,
organism = "hsa",
minGSSize = 5,
maxGSSize = 2000,
pvalueCutoff = 0.05)
# significant results
# Biological Process
significant_gseabp <- gseabp@result %>% filter(p.adjust < 0.05)
print(significant_gseabp)
# Molecular Function
significant_gseamf <- gseamf@result %>% filter(p.adjust < 0.05)
print(significant_gseamf)
# Cellular Component
significant_gseacc <- gseacc@result %>% filter(p.adjust < 0.05)
print(significant_gseacc)
# KEGG Pathways
significant_gseakegg <- gseakegg@result %>% filter(p.adjust < 0.05)
print(significant_gseakegg)
